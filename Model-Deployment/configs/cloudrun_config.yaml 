# configs/cloudrun_config.yaml
service:
  name: echoai-model-service
  memory: 2Gi
  cpu: 2
  timeout: 300  # 5 minutes
  max_instances: 10
  min_instances: 1
  concurrency: 100  # Max requests per instance
  port: 8080

model:
  name: echo-ai-model
  version: v1.0.0
  path: ./models/best_model.pkl
  bucket: echoai-models  # GCS bucket for model storage

monitoring:
  enable_monitoring: true
  alert_email: team@echoai.com
  slack_webhook: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
  performance_threshold:
    latency_ms: 1000
    error_rate: 0.05
    cpu_utilization: 0.8
    memory_utilization: 0.85

retraining:
  accuracy_threshold: 0.85
  drift_threshold: 0.3
  check_interval: 3600  # 1 hour
  auto_trigger: true

deployment:
  auto_scale:
    enabled: true
    target_cpu_utilization: 0.7
    target_memory_utilization: 0.8
    target_request_count: 1000
  
  traffic_split:
    stable: 90
    canary: 10

---
# cloudbuild.yaml
steps:
  # Build the container image
  - name: 'gcr.io/cloud-builders/docker'
    args: 
      - 'build'
      - '-t'
      - '${_REGION}-docker.pkg.dev/${PROJECT_ID}/cloud-run-source-deploy/echoai:${SHORT_SHA}'
      - '.'
  
  # Push to Artifact Registry
  - name: 'gcr.io/cloud-builders/docker'
    args:
      - 'push'
      - '${_REGION}-docker.pkg.dev/${PROJECT_ID}/cloud-run-source-deploy/echoai:${SHORT_SHA}'
  
  # Deploy to Cloud Run
  - name: 'gcr.io/cloud-builders/gcloud'
    args:
      - 'run'
      - 'deploy'
      - 'echoai-model-service'
      - '--image'
      - '${_REGION}-docker.pkg.dev/${PROJECT_ID}/cloud-run-source-deploy/echoai:${SHORT_SHA}'
      - '--region'
      - '${_REGION}'
      - '--platform'
      - 'managed'
      - '--memory'
      - '2Gi'
      - '--cpu'
      - '2'
      - '--timeout'
      - '300'
      - '--max-instances'
      - '10'
      - '--min-instances'
      - '1'
      - '--allow-unauthenticated'

substitutions:
  _REGION: us-central1

options:
  logging: CLOUD_LOGGING_ONLY
  machineType: 'E2_HIGHCPU_8'

---
# .gcloudignore
# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

.gcloudignore
.git
.gitignore
*.pyc
__pycache__/
/setup.cfg
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.DS_Store
.env
.env.*
venv/
env/
*.log
.vscode/
.idea/
*.swp
*.bak
test/
tests/
docs/
README.md
LICENSE